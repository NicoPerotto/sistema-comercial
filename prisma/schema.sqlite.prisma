datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // local: file:./dev.db
}

generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  username  String   @unique
  password  String
  role      String   @default("SELLER") 
  roleId    String?
  roleRef   Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
  shifts    Shift[]
  openedRegisters  CashRegister[] @relation("OpenedBy")
  closedRegisters  CashRegister[] @relation("ClosedBy")
  supplierPayments SupplierPayment[]
  weeklyClosures   WeeklyClosure[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  permissions String   @default("{\"windows\":[]}")
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Shift {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  startTime DateTime  @default(now())
  endTime   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  icon      String    @default("Package")
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id           String    @id @default(cuid())
  name         String
  brand        String    @default("")
  subcategory  String    @default("")
  description  String?
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id])
  barcode      String?   @unique
  price        Decimal
  cost         Decimal?
  hasIva       Boolean   @default(false)
  margin       Decimal   @default(0)
  stock        Decimal   @default(0)
  sellByWeight Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  saleItems    SaleItem[]
}

model PaymentMethod {
  id               String            @id @default(cuid())
  name             String            @unique
  percentage       Float             @default(0)
  isArqueable      Boolean           @default(true)
  sales            Sale[]
  supplierPayments     SupplierPayment[]
  weeklyClosureDetails WeeklyClosureDetail[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model CashRegister {
  id               String            @id @default(cuid())
  shortId          String            @unique
  openingAmount    Decimal
  closingAmount    Decimal?
  expectedAmount   Decimal?
  difference       Decimal?
  depositAmount    Decimal?
  status           String            @default("OPEN")
  openedById       String
  openedBy         User              @relation("OpenedBy", fields: [openedById], references: [id])
  closedById       String?
  closedBy         User?             @relation("ClosedBy", fields: [closedById], references: [id])
  openedAt         DateTime          @default(now())
  closedAt         DateTime?
  sales            Sale[]
  supplierPayments SupplierPayment[]
}

model Sale {
  id              String         @id @default(cuid())
  total           Decimal
  status          String         @default("COMPLETED")
  type            String
  auditLog        String?
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  createdAt       DateTime       @default(now())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  items           SaleItem[]
  cashRegisterId  String?
  cashRegister    CashRegister?  @relation(fields: [cashRegisterId], references: [id])
}

model SaleItem {
  id        String  @id @default(cuid())
  quantity  Decimal
  price     Decimal
  cost      Decimal?
  hasIva    Boolean @default(false)
  margin    Decimal @default(0)
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model Supplier {
  id        String            @id @default(cuid())
  name      String            @unique
  contact   String?
  payments  SupplierPayment[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model SupplierPayment {
  id              String        @id @default(cuid())
  shortId         String        @unique
  amount          Decimal
  description     String?
  paidFromCash    Boolean       @default(false)
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  cashRegisterId  String?
  cashRegister    CashRegister? @relation(fields: [cashRegisterId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  createdAt       DateTime      @default(now())
}

model FixedCost {
  id          String   @id @default(cuid())
  description String
  amount      Decimal
  date        DateTime @default(now())
}

model WeeklyClosure {
  id               String                 @id @default(cuid())
  shortId          String                 @unique
  startDate        DateTime
  endDate          DateTime               @default(now())
  totalExpected    Decimal
  totalReal        Decimal
  difference       Decimal
  details          WeeklyClosureDetail[]
  userId           String
  user             User                   @relation(fields: [userId], references: [id])
  createdAt        DateTime               @default(now())
}

model WeeklyClosureDetail {
  id               String               @id @default(cuid())
  weeklyClosureId  String
  weeklyClosure    WeeklyClosure        @relation(fields: [weeklyClosureId], references: [id])
  paymentMethodId  String
  paymentMethod    PaymentMethod        @relation(fields: [paymentMethodId], references: [id])
  expectedAmount   Decimal
  realAmount       Decimal
  difference       Decimal
}

model SystemConfig {
  id              String   @id @default(cuid())
  brandName       String   @default("PPG Gestión Comercial")
  description     String   @default("Sistema avanzado de gestión comercial, stock y ventas")
  sidebarTitle    String   @default("PPG")
  sidebarSubtitle String   @default("Gestión Comercial")
  theme           String   @default("warm-sand")
  updatedAt       DateTime @updatedAt
}
