datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) — runtime en Vercel
  directUrl = env("DIRECT_URL")   // directo (5432) — para prisma migrate
}

generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "rhel-openssl-3.0.x"] // build de Vercel (linux)
}

// SQLite doesn't support Enums natively, so we use String
// Allowed values logic should be handled in application layer: ADMIN, MANAGER, SELLER, PREVENTISTA
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  username  String   @unique
  password  String
  role      String   @default("SELLER") 
  roleId    String?
  roleRef   Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
  shifts    Shift[]
  openedRegisters  CashRegister[] @relation("OpenedBy")
  closedRegisters  CashRegister[] @relation("ClosedBy")
  supplierPayments SupplierPayment[]
  creditPayments   CreditPayment[]
  weeklyClosures   WeeklyClosure[]
}

// Roles configurables en el módulo "Sistema". Cada rol define qué ventanas
// del sidebar puede ver su usuario. `permissions` guarda JSON:
//   { "windows": ["/", "/ventas/nueva", "/productos", ...] }
// `isSystem` protege los roles base (ADMIN/MANAGER) de ser borrados.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique // ADMIN, MANAGER, OWNER, VENDEDOR, ...
  description String?
  isSystem    Boolean  @default(false)
  showInEmployees Boolean @default(false)
  permissions String   @default("{\"windows\":[]}") // JSON: { windows: string[] }
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Shift {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  startTime DateTime  @default(now())
  endTime   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  icon      String    @default("Package")
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id           String    @id @default(cuid())
  name         String
  brand        String    @default("")
  subcategory  String    @default("")
  description  String?
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id])
  barcode      String?   @unique
  price        Decimal
  cost         Decimal?
  hasIva       Boolean   @default(false)
  margin       Decimal   @default(0)
  stock        Decimal   @default(0)
  sellByWeight Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  saleItems    SaleItem[]
}

model PaymentMethod {
  id               String            @id @default(cuid())
  name             String            @unique
  percentage       Float             @default(0) // e.g., 10 for +10%, -5 for -5%
  isArqueable      Boolean           @default(true) // If true, it is included in cash count/arqueo
  isDefault        Boolean           @default(false) // Método preseleccionado en venta nueva (solo uno)
  isCredit         Boolean           @default(false) // Si true, la venta genera deuda (cuenta corriente)
  sales            Sale[]
  supplierPayments     SupplierPayment[]
  creditPayments       CreditPayment[]
  weeklyClosureDetails WeeklyClosureDetail[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model CashRegister {
  id               String            @id @default(cuid())
  shortId          String            @unique // Alphanumeric 5 chars
  openingAmount    Decimal
  closingAmount    Decimal?
  expectedAmount   Decimal?
  difference       Decimal?
  depositAmount    Decimal?          // Amount to be deposited in safe
  status           String            @default("OPEN") // OPEN, CLOSED
  openedById       String
  openedBy         User              @relation("OpenedBy", fields: [openedById], references: [id])
  closedById       String?
  closedBy         User?             @relation("ClosedBy", fields: [closedById], references: [id])
  openedAt         DateTime          @default(now())
  closedAt         DateTime?
  sales            Sale[]
  supplierPayments SupplierPayment[]
  creditPayments   CreditPayment[]
}

model Sale {
  id              String         @id @default(cuid())
  total           Decimal
  status          String         @default("COMPLETED") // PENDING, COMPLETED, CANCELLED
  type            String         // "VENTA", "PRESUPUESTO", "VENTA_NO_REALIZADA"
  auditLog        String?        // Store JSON analysis of additions and removals
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  creditCustomerId String?
  creditCustomer   CreditCustomer? @relation(fields: [creditCustomerId], references: [id], onDelete: SetNull)
  creditLimitExceeded Boolean    @default(false) // la venta superó el límite al registrarse
  creditLimitAtSale   Decimal?                    // límite vigente del cliente al momento de la venta
  createdAt       DateTime       @default(now())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  items           SaleItem[]
  cashRegisterId  String?
  cashRegister    CashRegister?  @relation(fields: [cashRegisterId], references: [id])

  @@index([creditCustomerId, status])
}

model SaleItem {
  id        String  @id @default(cuid())
  quantity  Decimal
  price     Decimal
  cost      Decimal?
  hasIva    Boolean @default(false)
  margin    Decimal @default(0)
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

// Cliente que compra "a cuenta" (cuenta corriente). El saldo se calcula
// dinámicamente: suma de ventas COMPLETED con creditCustomerId - suma de pagos.
model CreditCustomer {
  id        String   @id @default(cuid())
  name      String
  dni       String?  @unique
  phone     String?
  address   String?
  email     String?
  active    Boolean  @default(true)
  creditLimit Decimal? // null = sin límite; límite sobre la deuda acumulada
  sales     Sale[]
  payments  CreditPayment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// Cobro de deuda de un cliente a cuenta. Todo cobro exige una caja abierta.
// Si el método de pago es arqueable, suma al arqueo; si no, solo queda
// registrado para trazabilidad.
model CreditPayment {
  id              String         @id @default(cuid())
  amount          Decimal        // importe bruto recibido
  appliedAmount   Decimal?       // importe neto aplicado a reducir la deuda; null en cobros previos
  customerId      String
  customer        CreditCustomer @relation(fields: [customerId], references: [id])
  paymentMethodId String
  paymentMethod   PaymentMethod  @relation(fields: [paymentMethodId], references: [id])
  cashRegisterId  String
  cashRegister    CashRegister  @relation(fields: [cashRegisterId], references: [id])
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([customerId, createdAt])
  @@index([cashRegisterId])
}

model Supplier {
  id        String            @id @default(cuid())
  name      String            @unique
  contact   String?
  payments  SupplierPayment[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model SupplierPayment {
  id              String        @id @default(cuid())
  shortId         String        @unique // Alphanumeric code similar to CashRegister
  amount          Decimal
  description     String?
  paidFromCash    Boolean       @default(false)
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  cashRegisterId  String?
  cashRegister    CashRegister? @relation(fields: [cashRegisterId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  createdAt       DateTime      @default(now())
}

model FixedCost {
  id          String   @id @default(cuid())
  description String
  amount      Decimal
  date        DateTime @default(now())
}

model WeeklyClosure {
  id               String                 @id @default(cuid())
  shortId          String                 @unique
  startDate        DateTime
  endDate          DateTime               @default(now())
  totalExpected    Decimal
  totalReal        Decimal
  difference       Decimal
  details          WeeklyClosureDetail[]
  userId           String
  user             User                   @relation(fields: [userId], references: [id])
  createdAt        DateTime               @default(now())
}

model WeeklyClosureDetail {
  id               String               @id @default(cuid())
  weeklyClosureId  String
  weeklyClosure    WeeklyClosure        @relation(fields: [weeklyClosureId], references: [id])
  paymentMethodId  String
  paymentMethod    PaymentMethod        @relation(fields: [paymentMethodId], references: [id])
  expectedAmount   Decimal
  realAmount       Decimal
  difference       Decimal
}

// Configuración de branding del sistema (nombre + tema). Singleton.
model SystemConfig {
  id              String   @id @default(cuid())
  brandName       String   @default("PPG Gestión Comercial")
  description     String   @default("Sistema avanzado de gestión comercial, stock y ventas")
  sidebarTitle    String   @default("PPG")
  sidebarSubtitle String   @default("Gestión Comercial")
  theme           String   @default("warm-sand") // theme id from src/lib/themes.ts
  updatedAt       DateTime @updatedAt
}
